{
  "name": "swimhub-timer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "postinstall": "bash scripts/install-ffmpeg-frameworks.sh",
    "dev": "turbo dev --filter=@swimhub-timer/web",
    "dev:web": "turbo dev --filter=@swimhub-timer/web",
    "build": "turbo build --filter=!@swimhub-timer/mobile",
    "build:web": "turbo build --filter=@swimhub-timer/web",
    "lint": "turbo lint",
    "lint:web": "turbo lint --filter=@swimhub-timer/web",
    "lint:mobile": "turbo lint --filter=@swimhub-timer/mobile",
    "type-check": "turbo type-check",
    "dev:mobile": "pnpm --filter @swimhub-timer/mobile start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "deploy:web": "pnpm --filter @swimhub-timer/web run deploy",
    "test": "turbo test",
    "test:shared": "turbo test --filter=@swimhub-timer/shared",
    "test:web": "turbo test --filter=@swimhub-timer/web",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\""
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "unrs-resolver", "@shopify/react-native-skia"],
    "overrides": {
      "@types/react": "^19.2.14",
      "react-native-screens": "4.23.0",
      "glob@10": "^10.5.0",
      "jsdom": "^26.1.0",
      "tar": "^7.5.21",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "flatted": "^3.4.2",
      "browserslist": "^4.28.7",
      "fast-xml-parser": "^5.7.0",
      "fast-xml-builder": "^1.1.7",
      "undici": ">=7.29.1 <8",
      "ws": "^8.21.0",
      "form-data": "^4.0.6",
      "node-forge": "^1.4.0",
      "router>path-to-regexp": "^8.4.0",
      "picomatch@2": "2.3.2",
      "picomatch@3": "3.0.2",
      "picomatch@4": "4.0.4",
      "@xmldom/xmldom": "^0.8.15",
      "shell-quote": "^1.11.0",
      "tmp": "^0.2.6",
      "postcss": "^8.5.25",
      "nanoid@3": "^3.3.17",
      "proxy-addr": "^2.0.8",
      "compression": "^1.8.2",
      "source-map-js": "^1.2.2",
      "hono": "^4.12.25",
      "ip-address": "^10.5.1",
      "@modelcontextprotocol/sdk": "^1.32.0",
      "minimatch@3": "^3.1.5",
      "minimatch@5": "^5.1.9",
      "minimatch@8": "^8.0.7",
      "minimatch@9": "^9.0.9",
      "minimatch@10": "^10.2.3",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "fast-uri@3": "^3.1.9"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm",
        "GHSA-86w9-cpqp-85rv",
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-hp3w-g68c-fv3c",
        "GHSA-vcc3-ghjq-m6fr"
      ]
    }
  },
  "devDependencies": {
    "png-to-ico": "^3.0.1",
    "prettier": "^3.8.1",
    "turbo": "^2.8.16",
    "typescript": "^5"
  }
}
